{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reactive Angular Example",
  "version": "0.1.0",
  "identifier": "dev.tauri-plugin-reactive.example-angular",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tauri-plugin-reactive · Angular",
        "width": 760,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../shared/icons/32x32.png",
      "../../shared/icons/128x128.png",
      "../../shared/icons/icon.ico",
      "../../shared/icons/icon.icns"
    ]
  }
}
