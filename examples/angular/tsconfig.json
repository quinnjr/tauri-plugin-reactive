{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./out-tsc",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "files": ["src/main.ts"],
  "include": ["../shared/frontend/*.ts"]
}
